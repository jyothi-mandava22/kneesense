# Report-generation providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash

# Hugging Face model repository
HF_MODEL_REPO=KneeSense-cnn/kneesense-cnn
HF_TOKEN=

# Must match ML_SERVICE_SECRET in the root .env.kneesense
INTERNAL_AUTH_SECRET=replace-with-the-same-secret-used-by-the-java-backend

# Global live-report allowance per rolling 24 hours
GLOBAL_DAILY_CAP=200