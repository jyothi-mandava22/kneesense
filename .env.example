# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=kneesense
MYSQL_USER=kneesense_app
MYSQL_PASSWORD=replace-with-a-strong-application-password

# JWT signing secret: at least 32 UTF-8 bytes
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=43200000

# Optional initial administrator bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Must match INTERNAL_AUTH_SECRET in ml-service/.env
ML_SERVICE_SECRET=replace-with-the-same-secret-used-by-the-ml-service